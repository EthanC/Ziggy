# Optional Internet Archive email address and password; set both or leave both empty
ZIGGY_INTERNET_ARCHIVE_EMAIL=
ZIGGY_INTERNET_ARCHIVE_PASSWORD=

# Time without an HTTP 5XX response before Ziggy resets Archive.org backoff
ZIGGY_INTERNET_ARCHIVE_RECOVERY_PERIOD=15m

# Optional Discord Components v2 report webhook
ZIGGY_DISCORD_WEBHOOK_URL=

# Optional Loguru-Discord webhook; may equal the report webhook
ZIGGY_LOG_DISCORD_WEBHOOK_URL=
