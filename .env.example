# Docker container process and /ziggy ownership
PUID=1000
PGID=1000
TZ=Etc/UTC

# Optional Internet Archive email address and password; set both or leave both empty
ZIGGY_INTERNET_ARCHIVE_EMAIL=
ZIGGY_INTERNET_ARCHIVE_PASSWORD=

# Time without an HTTP 5XX response before Ziggy resets Archive.org backoff
ZIGGY_INTERNET_ARCHIVE_RECOVERY_PERIOD=15m

# Optional unauthenticated queue API; keep the loopback host unless publishing it
ZIGGY_HTTP_ENABLED=false
ZIGGY_HTTP_HOST=127.0.0.1
ZIGGY_HTTP_PORT=9449

# Daily SQLite backups; relative directories are beside the configured database
ZIGGY_BACKUP_ENABLED=true
ZIGGY_BACKUP_SCHEDULE=0 7 * * *
ZIGGY_BACKUP_DIRECTORY=backups
ZIGGY_BACKUP_RETENTION_COUNT=7
# Optional IANA timezone override; empty uses the system timezone configured by TZ
ZIGGY_BACKUP_TIMEZONE=

# Optional Discord Components v2 report webhook
ZIGGY_DISCORD_WEBHOOK_URL=

# Optional Loguru-Discord webhook; may equal the report webhook
ZIGGY_LOG_DISCORD_WEBHOOK_URL=
